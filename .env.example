# Clerk — https://dashboard.clerk.com/~/api-keys  (or run: npx clerk@latest init)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: Postgres for cloud-saved diagrams (Neon, Supabase, local…). Run schema.sql once.
DATABASE_URL=

# Optional: your own PlantUML server (defaults to the public plantuml.com server)
NEXT_PUBLIC_PLANTUML_SERVER=https://www.plantuml.com/plantuml

# Repo shown in the "Star on GitHub" button
NEXT_PUBLIC_GITHUB_REPO=tahmidbintaslim/umlstudio

# AI features (Vercel AI Gateway). Not needed on Vercel (uses OIDC automatically); needed for local dev.
AI_GATEWAY_API_KEY=

# Comma-separated emails that can open /admin (usage dashboard)
ADMIN_EMAILS=
